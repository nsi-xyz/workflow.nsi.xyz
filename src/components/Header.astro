---
import { navGroups, primaryNav } from "../data/navigation";
import ThemeToggle from "./ThemeToggle.astro";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="workflow.nsi.xyz — accueil">
      <span class="brand-mark" aria-hidden="true">⌘</span>
      <span class="brand-name">
        workflow.nsi.xyz <small>Piloter une IA, publier un site</small>
      </span>
    </a>

    <nav class="header-nav" aria-label="Navigation principale">
      {
        primaryNav.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <ThemeToggle />
      <details class="menu-mobile">
        <summary aria-label="Ouvrir le menu complet">
          <span aria-hidden="true">☰</span> Menu
        </summary>
        <nav class="menu-panel" aria-label="Toutes les pages">
          {
            navGroups.map((group) => (
              <>
                <span class="menu-group">{group.label}</span>
                {group.items.map((item) => (
                  <a href={`/${item.slug}`} aria-current={isCurrent(`/${item.slug}`) ? "page" : undefined}>
                    {item.title}
                  </a>
                ))}
              </>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
