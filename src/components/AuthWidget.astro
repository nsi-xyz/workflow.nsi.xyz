---
/**
 * Bouton d'identification, présent sur toutes les pages (via l'en-tête).
 *
 * Sans JavaScript : un simple lien vers login.nsi.xyz (repli). Avec JavaScript,
 * `src/client/auth.ts` le remplace par l'avatar et le menu du compte.
 */
const site = Astro.site?.origin ?? "https://workflow.nsi.xyz";
const retour = `${site}${Astro.url.pathname}`;
const lien = `https://login.nsi.xyz/login?redirect_uri=${encodeURIComponent(retour)}`;
---

<div class="auth" data-auth>
  <a class="auth-btn" href={lien} aria-label="S’identifier" title="S’identifier">
    <svg class="auth-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
      <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M5 20a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
    <span class="auth-nom">S’identifier</span>
  </a>
</div>

<script>
  import "../client/auth";
</script>
