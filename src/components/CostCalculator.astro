---
/**
 * Comparateur de coût — les formules viennent de src/lib/cout.ts, testées
 * côté serveur ET utilisées côté client (même code, même résultat).
 *
 * Le tableau est rendu au serveur pour le scénario par défaut (100 M de
 * jetons, 70 % de cache) : sans JavaScript, il reste lisible.
 */
import { coutModele, dollars, MIX_DEFAUT, MODELE_REFERENCE, modeles } from "../lib/cout";

const volumeDefaut = 100;
const cacheDefaut = Math.round(MIX_DEFAUT.cache * 100);
const reference = modeles.find((modele) => modele.id === MODELE_REFERENCE)!;
const coutReference = coutModele(reference, volumeDefaut, MIX_DEFAUT.cache);

const lignes = modeles
  .map((modele) => ({ ...modele, cout: coutModele(modele, volumeDefaut, MIX_DEFAUT.cache) }))
  .sort((a, b) => a.cout - b.cout);

const resumeDefaut = `Coût estimé pour ${volumeDefaut} M de jetons : de ${dollars(lignes[0].cout)} (${lignes[0].nom}) à ${dollars(lignes[lignes.length - 1].cout)} (${lignes[lignes.length - 1].nom}).`;
---

<div class="glass calc" data-calc>
  <div class="calc-fields">
    <label class="calc-field">
      <span>Volume total du projet (millions de jetons)</span>
      <input type="number" min="1" step="10" value={volumeDefaut} data-calc-volume />
    </label>

    <label class="calc-field">
      <span>Part du contexte déjà en cache</span>
      <input type="range" min="0" max="95" step="5" value={cacheDefaut} data-calc-cache />
      <output data-calc-cache-sortie>{cacheDefaut} %</output>
    </label>

    <label class="calc-field calc-abonnement">
      <span><input type="checkbox" data-calc-abonnement /> Tenir compte d'un abonnement (÷6 sur les modèles compatibles)</span>
    </label>
  </div>

  <p class="calc-total" data-calc-total role="status" aria-live="polite">{resumeDefaut}</p>

  <div class="table-scroll">
    <table class="calc-table" data-calc-table>
      <caption class="sr-only">Coût estimé par modèle pour le scénario choisi</caption>
      <thead>
        <tr>
          <th scope="col">Modèle</th>
          <th scope="col">Famille</th>
          <th scope="col">Coût du scénario</th>
          <th scope="col">× DeepSeek</th>
        </tr>
      </thead>
      <tbody data-calc-corps>
        {
          lignes.map((modele) => (
            <tr data-calc-ligne data-modele-id={modele.id} data-nom={modele.nom} data-cout={modele.cout}>
              <th scope="row">
                {modele.nom}
                {modele.recommande && <span class="badge"> conseillé</span>}
              </th>
              <td>{modele.famille}</td>
              <td data-calc-cout>{dollars(modele.cout)}</td>
              <td data-calc-ratio>{`×${(modele.cout / coutReference).toFixed(1).replace(".", ",")}`}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="calc-note">
    Tarifs publics relevés le 30/09/2026 (dollars US, par million de jetons), hors promotions.
    Le cache est automatique : la part « déjà en cache » reste une estimation.
    Les modèles marqués « abonnement » sont couverts par un plan à prix fixe type OpenCode Go.
  </p>
</div>

<script>
  import { coutModele, dollars, MODELE_REFERENCE, modeles, type ModeleCout } from "../lib/cout";

  const root = document.querySelector<HTMLElement>("[data-calc]");

  if (root) {
    const champ = <T extends Element>(selecteur: string) => root.querySelector<T>(selecteur);

    const volume = champ<HTMLInputElement>("[data-calc-volume]");
    const cache = champ<HTMLInputElement>("[data-calc-cache]");
    const cacheSortie = champ<HTMLOutputElement>("[data-calc-cache-sortie]");
    const abonnement = champ<HTMLInputElement>("[data-calc-abonnement]");
    const corps = champ<HTMLElement>("[data-calc-corps]");
    const totalNode = champ<HTMLElement>("[data-calc-total]");
    const parId = new Map<string, ModeleCout>(modeles.map((modele) => [modele.id, modele]));

    const maj = () => {
      const volumeMillions = Math.max(1, Number(volume?.value) || 1);
      const partCache = Math.min(Math.max((Number(cache?.value) || 0) / 100, 0), 0.95);
      const avecAbonnement = abonnement?.checked ?? false;
      const reference = parId.get(MODELE_REFERENCE)!;
      const coutReference = coutModele(reference, volumeMillions, partCache) / (avecAbonnement ? 6 : 1);

      const lignes = [...(corps?.querySelectorAll<HTMLTableRowElement>("[data-calc-ligne]") ?? [])];

      for (const ligne of lignes) {
        const modele = parId.get(ligne.dataset.modeleId ?? "");
        if (!modele) continue;
        let cout = coutModele(modele, volumeMillions, partCache);
        if (avecAbonnement && modele.abonnement) cout /= 6;

        const celluleCout = ligne.querySelector<HTMLElement>("[data-calc-cout]");
        const celluleRatio = ligne.querySelector<HTMLElement>("[data-calc-ratio]");
        if (celluleCout) celluleCout.textContent = dollars(cout);
        if (celluleRatio) celluleRatio.textContent = `×${(cout / coutReference).toFixed(1).replace(".", ",")}`;
        ligne.dataset.cout = String(cout);
      }

      const triees = lignes.sort((a, b) => Number(a.dataset.cout) - Number(b.dataset.cout));
      for (const ligne of triees) corps?.append(ligne);

      if (cacheSortie) cacheSortie.textContent = `${Math.round(partCache * 100)} %`;
      if (totalNode) {
        const premier = triees[0];
        const dernier = triees[triees.length - 1];
        const suffixe = avecAbonnement ? " (abonnement inclus)" : "";
        totalNode.textContent = `Coût estimé pour ${volumeMillions} M de jetons : de ${dollars(Number(premier?.dataset.cout ?? 0))} (${premier?.dataset.nom ?? ""}) à ${dollars(Number(dernier?.dataset.cout ?? 0))} (${dernier?.dataset.nom ?? ""})${suffixe}.`;
      }
    };

    root.addEventListener("input", maj);
    maj();
  }
</script>
