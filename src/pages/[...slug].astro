---
import DocLayout from "../layouts/DocLayout.astro";
import { navItems, type NavItem } from "../data/navigation";

/**
 * Pages « squelette » : elles sont générées depuis navigation.ts tant qu'une
 * page dédiée n'existe pas dans src/pages/. Dès qu'un fichier .astro est créé
 * pour une section, elle disparaît d'ici automatiquement (détection ci-dessous).
 *
 * Attention : `getStaticPaths` est hoisté par Astro et n'a pas accès aux
 * variables du frontmatter — la détection vit donc à l'intérieur de la fonction.
 */
export function getStaticPaths() {
  const built = new Set(
    Object.keys(import.meta.glob("./**/*.astro")).map((path) =>
      path.replace(/^\.\//, "").replace(/\.astro$/, ""),
    ),
  );

  return navItems
    .filter((item) => !built.has(item.slug))
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

interface Props {
  item: NavItem;
}

const { item } = Astro.props;
---

<DocLayout item={item}>
  <div class="callout callout-info">
    <span class="callout-title">Section en cours de rédaction</span>
    <p>
      Le plan ci-dessous annonce le contenu exact de cette page. Elle sera complétée
      avec des exemples, des captures et des exercices — sans jamais dépendre d'une
      date de cours.
    </p>
  </div>
</DocLayout>
