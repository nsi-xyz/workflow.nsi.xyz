# Copier vers .env puis compléter — ne JAMAIS commiter .env (workflow.md § 2)
# Le jeton Cloudflare est un jeton de COMPTE : un seul pour tous les sites frères.

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- Développement ---
# Port stable de ce projet (4321/4322/4398 sont pris par les sites frères)
DEV_PORT=4323

# --- Contenu ---
# Révélation du projet final : lundi de la dernière semaine avant la Toussaint
REVEAL_AT=2026-10-12T08:42

# --- Espace prof (valeurs posées sur Cloudflare Pages, jamais commitées) ---
# PROF_PASSWORD=
# SESSION_SECRET=

# En développement, ces deux secrets vivent dans .dev.vars (ignoré par Git),
# car `wrangler pages dev` lit ce fichier et non `.env`.
# Le mot de passe local de démonstration est « demo-prof ».
